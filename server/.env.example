# Smart PDF Learning Assistant Environment Settings

# Port for backend Express server
PORT=5000

# Groq API Key (Get your free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Vision API Key (Optional - leave empty or set to GROQ_API_KEY if vision model is available)
VISION_API_KEY=

# Storage Directories
UPLOAD_DIR=../uploads
PROCESSED_DIR=../processed
CACHE_DIR=../cache
